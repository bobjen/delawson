#!/usr/bin/env bash
# Stop everything start-laws started, debug or retail, in reverse cold-start
# order.
#
# Stopping is a request first: a process that has state to flush gets the chance,
# and signals are the fallback for one that will not answer.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
run_dir=$root/run
grace=3        # seconds to wait for a polite shutdown, then for SIGTERM
keep=no        # keep the run directories and their data

usage() {
    cat <<'EOF'
usage: stop-laws [--run-dir DIR] [--grace SECONDS] [--clean]

  --run-dir   where the per-process directories are (default: run/)
  --grace     seconds to wait at each escalation (default: 3)
  --clean     remove the run directories once everything has stopped
EOF
}

while (($#)); do
    case $1 in
        --run-dir) run_dir=$2; shift ;;
        --grace) grace=$2; shift ;;
        --clean) keep=clean ;;
        -h|--help) usage; exit 0 ;;
        *) echo "stop-laws: unknown argument $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

[[ -d $run_dir ]] || { echo "stop-laws: no $run_dir, nothing to stop"; exit 0; }

# The client from the same build as the running processes. Falling back to the
# other build is a trap: it may predate a configuration change and then fail for
# a reason that looks like the process ignoring us.
laws=$root/target/$(cat "$run_dir/build" 2>/dev/null || echo debug)/laws
[[ -x $laws ]] || laws=""

# Reverse cold-start order: nothing should outlive what it depends on, and within
# a kind the highest-numbered instance goes first, so KS0 - the registrar - is the
# last process in the cluster to stop.
order=(fe en sn dn ks)
dirs=()
for kind in "${order[@]}"; do
    for dir in $(printf '%s\n' "$run_dir"/*/ | sort -r); do
        [[ -f ${dir}process.toml ]] || continue
        [[ $(sed -n 's/^kind = "\(.*\)"/\1/p' "${dir}process.toml") == "$kind" ]] || continue
        dirs+=("${dir%/}")
    done
done

wait_gone() {   # pid, seconds
    local pid=$1 waited=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep 0.05
        waited=$((waited + 1))
        ((waited < $2 * 20)) || return 1
    done
    return 0
}

for dir in "${dirs[@]}"; do
    identity=$(basename "$dir")
    if [[ ! -f $dir/ready ]]; then
        echo "$identity was not running"
        continue
    fi
    pid=$(sed -n 's/^pid=//p' "$dir/ready")
    if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
        echo "$identity had stopped already"
        rm -f "$dir/ready"
        continue
    fi

    # Straight to the address in the run directory: a shutdown must not depend on
    # KS still being up to look the process up.
    listen=$(sed -n 's/^listen = "\(.*\)"/\1/p' "$dir/process.toml")
    asked=no
    if [[ -n $laws && -n $listen ]]; then
        # Keep the reason. Escalating silently makes a client that could not even
        # send the request look like a process that ignored it.
        if why=$("$laws" --config "$dir/cluster.toml" --at "$listen" --to "$identity" \
            shutdown 2>&1); then
            asked=yes
        else
            echo "stop-laws: $identity would not take the request: $why" >&2
        fi
    fi

    how=""
    if [[ $asked == yes ]] && wait_gone "$pid" "$grace"; then
        how="on request"
    elif kill -TERM "$pid" 2>/dev/null && wait_gone "$pid" "$grace"; then
        how="on SIGTERM"
    elif kill -KILL "$pid" 2>/dev/null && wait_gone "$pid" "$grace"; then
        how="on SIGKILL"
    fi
    rm -f "$dir/ready"
    echo "stopped $identity (pid $pid) ${how:-but it is still alive}"
    [[ -n $how ]] || exit 1
done

if [[ $keep == clean ]]; then
    rm -rf "$run_dir"
    echo "removed $run_dir"
fi
