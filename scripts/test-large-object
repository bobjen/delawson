#!/usr/bin/env bash
# Expensive, opt-in end-to-end large-object test. It intentionally uses a temporary
# configuration and run directory, and leaves the checked-in test cluster untouched.
set -euo pipefail

phase=all
if [[ ${1:-} == --extent-only ]]; then
    phase=extent
    shift
fi
[[ $# == 0 ]] || { echo "usage: $0 [--extent-only]" >&2; exit 2; }

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/delawson-large-object.XXXXXX")
config=$tmp/config
run=$tmp/run
mkdir -p "$config"
cp -a "$root/config/." "$config/"
sed -i \
    -e 's/^seal_bytes = .*/seal_bytes = 33554432/' \
    -e 's/^per_stream = .*/per_stream = 1048576/' \
    "$config/cluster.toml"
sed -i '/^seal_bytes = /a max_append_bytes = 33554432' "$config/cluster.toml"

cleanup() {
    status=$?
    if ((status != 0)); then
        echo "large-object: failed; recent FE/EN logs:" >&2
        for log in "$run"/FE*/stderr.log "$run"/EN*/stderr.log; do
            [[ -f $log ]] || continue
            echo "--- $log" >&2
            tail -n 20 "$log" >&2 || true
        done
    fi
    "$root/scripts/stop-laws" --run-dir "$run" --clean >/dev/null 2>&1 || true
    rm -rf "$tmp"
}
trap cleanup EXIT

"$root/scripts/start-laws" --release --run-dir "$run" --config "$config"
laws=$root/target/release/laws
block=$tmp/block
python3 - "$block" <<'PY'
import sys
record = b"Doctor, sometimes I have the feeling that I'm not accomplishing anything other than taking up space\0"
target = 32 * 1024 * 1024
with open(sys.argv[1], "wb") as output:
    # Canonical logical length is body bytes plus four bytes per completed
    # record, so leave room for the record framing as well as the NUL marker.
    count = (target - 1) // (len(record) + 4)
    output.write(record * count)
PY

path=/large-object
block_bytes=$(stat -c '%s' "$block")
blocks=$(( ((1 << 32) - 1) / block_bytes ))
blocks=${LARGE_BLOCKS:-$blocks}
parallel=${LARGE_PARALLEL:-4}
((parallel > 0)) || { echo "large-object: LARGE_PARALLEL must be positive" >&2; exit 2; }
running=0
for ((n = 0; n < blocks; n++)); do
    "$laws" --config "$config/cluster.toml" append-block "$path" --file "$block" &
    running=$((running + 1))
    if ((running >= parallel)); then
        wait -n
        running=$((running - 1))
    fi
done
wait

if [[ $phase == extent ]]; then
    echo "large-object: one-extent phase complete; inspecting the object"
    "$laws" --config "$config/cluster.toml" object-info "$path" --want extents
    exit 0
fi

# The final block is deliberately followed by the explicit forced seal, since the
# extent is full by logical size while per_stream is intentionally very large.
"$laws" --config "$config/cluster.toml" seal "$path"
"$laws" --config "$config/cluster.toml" object-info "$path" --want counts

source=$path
destinations=(
    /large-object/concat-2
    /large-object/concat-6
    /large-object/concat-7
    /large-object/concat-9
    /large-object/concat-10
    /large-object/concat-11
    /large-object/concat-12
    /large-object/concat-22
    /large-object/concat-28
    /large-object/concat-32
    /large-object/concat-37
    /large-object/concat-38
    /large-object/concat-53
    /large-object/concat-60
    /large-object/concat-61
    /large-object/concat-62
    /large-object/concat-63
    /large-object/concat-66
    /large-object/concat-71
    /large-object/concat-73
    /large-object/concat-75
    /large-object/concat-83
    /large-object/concat-85
    /large-object/concat-87
    /large-object/concat-89
    /large-object/concat-91
    /large-object/concat-95
    /large-object/concat-96
    /large-object/concat-97
    /large-object/concat-102
    /large-object/concat-104
    /large-object/concat-105
    /large-object/concat-107
    /large-object/concat-111
    /large-object/concat-113
    /large-object/concat-116
    /large-object/concat-120
    /large-object/concat-124
    /large-object/concat-125
    /large-object/concat-126
    /large-object/concat-128
    /large-object/concat-130
    /large-object/concat-131
    /large-object/concat-132
    /large-object/concat-133
    /large-object/concat-135
    /large-object/concat-136
    /large-object/concat-138
    /large-object/concat-140
    /large-object/concat-141
    /large-object/concat-145
    /large-object/concat-149
    /large-object/concat-150
    /large-object/concat-154
    /large-object/concat-155
    /large-object/concat-156
    /large-object/concat-157
    /large-object/concat-165
    /large-object/concat-173
    /large-object/concat-175
    /large-object/concat-179
    /large-object/concat-181
    /large-object/concat-182
    /large-object/concat-184
)
for ((n = 0; n < ${#destinations[@]}; n++)); do
    destination=${destinations[n]}
    if ! "$laws" --config "$config/cluster.toml" concat "$destination" "$source" "$source"; then
        echo "large-object: concat stopped at iteration $n (first error)" >&2
        exit 0
    fi
    "$laws" --config "$config/cluster.toml" seal "$destination"
    "$laws" --config "$config/cluster.toml" object-info "$destination" --want counts
    source=$destination
done
echo "large-object: reached the script's same-DN name bound without an error" >&2
