#!/usr/bin/env bash
# Start every process in the service directory, in cold-start order, each in its
# own run directory holding its own configuration.
#
# Keeping processes up and keeping machines patched is outside DeLawson's scope;
# this script substitutes for that on one box by starting them once.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
profile=debug
unlock_mode=direct
machine_identity=
run_dir=$root/run
config_dir=$root/config
ready_wait=10   # seconds to wait for a process to announce itself

usage() {
    cat <<'EOF'
usage: start-laws [--debug | --release] [--run-dir DIR] [--config DIR] [--no-build] [--unlock-mode direct|shards] [--machine-identity DIR]

  --debug     build and run the debug binaries (default)
  --release   build and run the optimized binaries; measure with these
  --run-dir   where the per-process directories go (default: run/)
  --config    where the checked-in configuration lives (default: config/)
  --machine-identity  opt into TLS using a pre-created local identity directory
  --unlock-mode  direct (default, fast) or shards (7-of-13 local reconstruction)
  --no-build  use the binaries already built
EOF
}

build=yes
while (($#)); do
    case $1 in
        --debug) profile=debug ;;
        --release|--retail) profile=release ;;
        --run-dir) run_dir=$2; shift ;;
        --config) config_dir=$2; shift ;;
        --no-build) build=no ;;
        --unlock-mode) unlock_mode=$2; shift ;;
        --machine-identity) machine_identity=$2; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "start-laws: unknown argument $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

case $unlock_mode in
    direct|shards) ;;
    *) echo "start-laws: --unlock-mode must be direct or shards" >&2; exit 2 ;;
esac

target=debug
cargo_args=()
if [[ $profile == release ]]; then
    target=release
    cargo_args+=(--release)
fi

cluster=$config_dir/cluster.toml
[[ -f $cluster ]] || { echo "start-laws: no $cluster" >&2; exit 1; }

if [[ $build == yes ]]; then
    cargo build --manifest-path "$root/Cargo.toml" "${cargo_args[@]}"
fi
bin=$root/target/$target
laws=$bin/laws
[[ -x $laws ]] || { echo "start-laws: no $laws; drop --no-build" >&2; exit 1; }

# Refuse to start a second copy on top of a live one.
for ready in "$run_dir"/*/ready; do
    [[ -f $ready ]] || continue
    pid=$(sed -n 's/^pid=//p' "$ready")
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
        echo "start-laws: $(dirname "$ready") is still running as pid $pid; stop-laws first" >&2
        exit 1
    fi
    rm -f "$ready"
done

mkdir -p "$run_dir"
# The build directory, not the word: stop-laws needs a path that exists.
echo "$target" > "$run_dir/build"
# Clear the name this file used to have, so a run directory from an older checkout
# does not leave a stale one behind.
rm -f "$run_dir/flavor"

# Trusted single-host bootstrap admits this machine for the configured services.
# Only its public key enters cluster.toml; local credentials stay in process.toml.
if [[ -n $machine_identity ]]; then
    machine_identity=$(cd "$machine_identity" && pwd)
    [[ -f $machine_identity/identity.toml && -f $machine_identity/public.hex ]] || {
        echo "start-laws: use scripts/machine-identity to create the identity directory" >&2; exit 1;
    }
    cp "$cluster" "$run_dir/cluster.toml"
    python3 - "$run_dir/cluster.toml" "$machine_identity/public.hex" "$laws" <<'PYAUTH'
import json, pathlib, subprocess, sys, tomllib
path = pathlib.Path(sys.argv[1])
text = path.read_text()
if 'authentication' in tomllib.loads(text)['messaging']:
    raise SystemExit('start-laws: --machine-identity expects a config without pre-existing enrollment')
services = [line.split()[0] for line in subprocess.check_output([sys.argv[3], '--config', str(path), 'services'], text=True).splitlines()]
public = pathlib.Path(sys.argv[2]).read_text().strip()
bytes.fromhex(public)
path.write_text(text + '\n[[messaging.authentication.members]]\npublic_key = ' + json.dumps(public) + '\nservices = ' + json.dumps(services) + '\n')
PYAUTH
    cluster=$run_dir/cluster.toml
fi

# KS's address is fixed; every other process is handed a port from the base up.
# A bad configuration fails here, and it has to fail loudly: without this the
# variables below are simply unset, and the error is about a shell variable
# rather than about the configuration that is actually wrong.
if ! bootstrap=$("$laws" --config "$cluster" bootstrap); then
    echo "start-laws: $cluster is not a configuration this build will run" >&2
    exit 1
fi
eval "$(sed 's/^/ks_/;s/ /=/' <<<"$bootstrap")"
ks_host=${ks_address%:*}
next_port=$ks_port_base

# Development ceremony material stays outside the KS process directory. Reuse it
# across starts; never silently replace existing recovery material.
ceremony=$run_dir/unlock-$unlock_mode
if [[ ! -d $ceremony ]]; then
    generate_args=()
    [[ $unlock_mode == direct ]] && generate_args+=(--direct)
    "$laws" unlock-generate --output-dir "$ceremony" "${generate_args[@]}"
fi
verifier=$(cat "$ceremony/verifier")
[[ $verifier =~ ^[0-9a-f]{64}$ ]] || { echo "invalid unlock verifier" >&2; exit 1; }
unlock_args=()
if [[ $unlock_mode == direct ]]; then
    unlock_args=(--key-file "$ceremony/unlock-key")
else
    unlock_args=(--share "$ceremony"/share-0{1,2,3,4,5,6,7})
fi

started=()
while read -r identity kind domain _; do
    dir=$run_dir/$identity
    service_config=$config_dir/$kind.toml
    [[ -f $service_config ]] || { echo "start-laws: no $service_config" >&2; exit 1; }
    [[ -x $bin/$kind ]] || { echo "start-laws: no $bin/$kind" >&2; exit 1; }

    if [[ $identity == "$ks_registrar" ]]; then
        listen=$ks_address
    else
        listen=$ks_host:$next_port
        next_port=$((next_port + 1))
    fi

    mkdir -p "$dir/data"
    cp "$cluster" "$dir/cluster.toml"
    cp "$service_config" "$dir/$kind.toml"
    if [[ $kind == ks ]]; then
        sed -i '/^require_unlock *=/d; /^unlock_verifier *=/d' "$dir/$kind.toml"
        sed -i "1i require_unlock = true\nunlock_verifier = \"$verifier\"" "$dir/$kind.toml"
    fi
    cat > "$dir/process.toml" <<EOF
# Written by start-laws. Says who this process is, which port it was given, and
# where the shared configuration is; everything else comes from those files.
identity = "$identity"
kind = "$kind"
listen = "$listen"
cluster_config = "cluster.toml"
service_config = "$kind.toml"
data_dir = "data"
EOF

    if [[ -n $machine_identity ]]; then
        # JSON strings are also valid TOML basic strings for these paths.
        python3 - "$dir/process.toml" "$machine_identity/identity.toml" <<'PYIDENTITY'
import json, pathlib, sys
with pathlib.Path(sys.argv[1]).open('a') as file:
    file.write('machine_identity = ' + json.dumps(sys.argv[2]) + '\n')
PYIDENTITY
    fi
    rm -f "$dir/ready"
    # Whatever the process says before its own logs are open, plus anything the
    # kernel says about it. Its real logs are in $dir/logs.
    nohup "$bin/$kind" "$dir/process.toml" >> "$dir/stderr.log" 2>&1 &
    pid=$!

    waited=0
    while [[ ! -f $dir/ready ]]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "start-laws: $identity died before it was ready; tail of $dir/stderr.log:" >&2
            tail -n 20 "$dir/stderr.log" >&2
            exit 1
        fi
        sleep 0.02
        waited=$((waited + 1))
        if ((waited > ready_wait * 50)); then
            echo "start-laws: $identity did not become ready in ${ready_wait}s" >&2
            exit 1
        fi
    done
    echo "started $identity ($kind, $profile) on $listen as pid $pid"
    if [[ $kind == ks ]]; then
        "$laws" --config "$cluster" --at "$listen" --to "$identity" unlock "${unlock_args[@]}"
    fi
    started+=("$identity")
done < <("$laws" --config "$cluster" services)

((${#started[@]})) || echo "start-laws: the roster is empty" >&2

# Push the current communication graph through KS. KS relays one message per
# source, and each destination address is resolved once while building that
# message; the receiving process keeps the addresses and opens connections lazily.
mapfile -t sn_ids < <("$laws" --config "$cluster" services | awk '$2 == "sn" { print $1 }')
mapfile -t en_ids < <("$laws" --config "$cluster" services | awk '$2 == "en" { print $1 }')
mapfile -t dn_ids < <("$laws" --config "$cluster" services | awk '$2 == "dn" { print $1 }')
for source in "${dn_ids[@]}"; do
    source_number=${source//[^0-9]/}
    destinations=()
    for ((n = 0; n < ${#sn_ids[@]}; n++)); do
        ((n == source_number)) && continue
        destinations+=("${sn_ids[n]}")
    done
    ((${#destinations[@]})) && "$laws" --config "$cluster" --to "$ks_registrar" assign-peers "$source" "${destinations[@]}"
done
for source in "${sn_ids[@]}"; do
    source_number=${source//[^0-9]/}
    case "$source_number" in
        0) destinations=("${en_ids[0]}" "${en_ids[2]}") ;;
        1) destinations=("${en_ids[1]}" "${en_ids[3]}") ;;
        2) destinations=("${en_ids[0]}" "${en_ids[3]}") ;;
        3) destinations=("${en_ids[1]}" "${en_ids[2]}") ;;
        *) echo "start-laws: no EN assignment for $source" >&2; exit 1 ;;
    esac
    "$laws" --config "$cluster" --to "$ks_registrar" assign-peers "$source" "${destinations[@]}"
done

echo
"$laws" --config "$cluster" placement
echo "run dir $run_dir"
echo "try: $laws --config $cluster ping --to ${started[0]:-KS0} --count 10000"
