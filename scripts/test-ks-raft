#!/usr/bin/env python3
"""Three KS processes: election, encrypted recovery, failover and quorum loss. No TPM required."""
import argparse
import json
import os
import signal
from pathlib import Path
import socket
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT/'target/debug'

def run(args, success=True):
    result = subprocess.run(list(map(str, args)), capture_output=True, text=True, timeout=30)
    if (result.returncode == 0) != success:
        raise RuntimeError(result.stdout + result.stderr)
    return result.stdout + result.stderr

def port():
    with socket.socket() as s:
        s.bind(('127.0.0.1', 0))
        return s.getsockname()[1]

def until(check, timeout=15):
    end = time.monotonic() + timeout
    last = None
    while time.monotonic() < end:
        try:
            result = check()
            if result:
                return result
        except (RuntimeError, OSError) as e:
            last = e
        time.sleep(.05)
    raise RuntimeError(f'condition timed out: {last}')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--registrations-only', action='store_true', help='test endpoint persistence without destructive state-loss recovery')
    args = parser.parse_args()
    children = {}
    with tempfile.TemporaryDirectory(prefix='delawson-ks-raft-') as temporary:
        work = Path(temporary)
        members = {f'KS0-member{i}': f'127.0.0.1:{port()}' for i in range(3)}
        host = work/'host'
        run([ROOT/'scripts/machine-identity', '--output-dir', host, '--software'])
        ceremony = work/'ceremony'
        run([BIN/'laws', 'unlock-generate', '--direct', '--output-dir', ceremony])
        cluster = work/'cluster.toml'
        text = (ROOT/'config/cluster.toml').read_text().replace('127.0.0.1:9601', members['KS0-member0'])
        text = text.replace('kind = "ks"\ncount = 3', 'kind = "ks"\nidentity = "KS0-member0"')
        for i in range(1, 4):
            text += f'\n[[service]]\nkind = "ks"\nidentity = "KS0-member{i}"\ndomain = ["region0", "dc0", "rack0", "box0", "disk0"]\n'
        indexes = {f'KS0-member{i}': i for i in range(3)}
        text += '\n[[messaging.authentication.members]]\npublic_key = '+json.dumps((host/'public.hex').read_text().strip())+'\nservices = ["KS0-member0", "KS0-member1", "KS0-member2", "KS0-member3", "EN0"]\n'
        cluster.write_text(text)
        config = work/'ks.toml'
        text = (ROOT/'config/ks.toml').read_text().replace('require_unlock = false', 'require_unlock = true').replace('master_key_delay_secs = 3600', 'master_key_delay_secs = 1').replace('snapshot_interval_secs = 86400', 'snapshot_interval_secs = 1')
        text = 'unlock_verifier = '+json.dumps((ceremony/'verifier').read_text().strip())+'\n'+text
        text += '\n[raft]\nring = "KS0"\ncheckpoint_lease_secs = 1\nheartbeat_ms = 75\nelection_min_ms = 150\nelection_max_ms = 300\nrequest_timeout_ms = 200\n[raft.members]\n'+''.join(f'{id} = {json.dumps(address)}\n' for id, address in members.items())
        text += '\n[raft.member_indexes]\n' + ''.join(f'{name} = {index}\n' for name, index in indexes.items())
        config.write_text(text)
        run([ROOT/'scripts/ring-identities', cluster, cluster, work/'ring-identities.toml', config])
        for name in members:
            run([ROOT/'scripts/member-identity', cluster, name, work/name/'data/master-keys'])
        markers = list(work.glob('*/data/master-keys/need-bootstrap'))
        assert len(markers) == 1, markers
        def command(id, *args, success=True):
            result = run([BIN/'laws', '--config', cluster, '--to', id, '--at', members[id], '--machine-identity', host/'identity.toml', *args], success)
            return '\n'.join(line.removeprefix(id+' ') for line in result.splitlines())
        def start(id):
            directory = work/id
            directory.mkdir(exist_ok=True)
            (directory/'ready').unlink(missing_ok=True)
            settings = dict(identity=id, kind='ks', listen=members[id], cluster_config=str(cluster), service_config=str(config), data_dir=str(directory/'data'), machine_identity=str(host/'identity.toml'))
            path = directory/'process.toml'
            path.write_text(''.join(f'{k} = {json.dumps(v)}\n' for k,v in settings.items()))
            with (directory/'stderr').open('a') as stderr:
                children[id] = subprocess.Popen([BIN/'ks', path], stdout=stderr, stderr=stderr)
            until(lambda: (directory/'ready').exists())
        def stop(id):
            child = children.pop(id)
            child.kill()
            child.wait(timeout=10)
        def status(id):
            child = children[id]
            if child.poll() is not None:
                assert child.returncode == 0, (id, child.returncode)
                children.pop(id)
                start(id)
            text = command(id, 'status')
            return dict(line.split(' ', 1) for line in text.splitlines() if ' ' in line)
        def leader(exclude=()):
            found = [id for id in children if id not in exclude and children[id].poll() is None and status(id).get('raft_role') == 'Leader']
            return found[0] if len(found) == 1 else None
        try:
            for id in members: start(id)
            primary = until(leader)
            assert all(status(id).get('unlocked') == 'false' for id in children)
            # Elections and commitment of a term's no-op work while every KS is locked.
            until(lambda: all(int(status(id)['raft_commit']) > 0 for id in children))
            command(primary, 'unlock', '--key-file', ceremony/'unlock-key')
            until(lambda: all(status(id).get('unlocked') == 'true' and int(status(id)['master_keys']) == 1 for id in children))
            creation = str(int(time.time()))
            expected = command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation)
            follower = next(id for id in children if id != primary)
            assert command(follower, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            command(primary, 'rotate-master-key')
            until(lambda: all(int(status(id)['master_keys']) == 2 for id in children))
            time.sleep(1.1)
            creation = str(int(time.time()))
            expected = command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation)
            until(lambda: all(len(list((work/id/'data/master-keys').glob('snapshot-*.bin'))) > 1 for id in children))
            # Suspend the primary so another is elected, then resume the stale process.
            # It must terminate itself on demotion, not continue in a newer term.
            old_primary = children[primary]
            os.kill(old_primary.pid, signal.SIGSTOP)
            successor = until(lambda: leader(exclude=(primary,)))
            actual = command(successor, 'sn-master-key', '--sn', '0', '--creation-second', creation)
            assert actual == expected
            os.kill(old_primary.pid, signal.SIGCONT)
            until(lambda: old_primary.poll() is not None)
            exit_code = old_primary.wait(timeout=10)
            assert exit_code == 0, exit_code
            children.pop(primary)
            start(primary)
            until(lambda: status(primary).get('unlocked') == 'true' and status(primary).get('raft_leader') != 'none' and int(status(primary)['master_keys']) == 2)
            assert command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            moved = next(id for id in members if id != 'KS0-member0' and id != until(leader))
            stop(moved)
            members[moved] = f'127.0.0.1:{port()}'
            start(moved)
            until(lambda: status(moved).get('unlocked') == 'true' and status(moved).get('raft_leader') != 'none' and int(status(moved)['master_keys']) == 2)
            assert command(moved, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            # Keep the obsolete seed: locked restart must recover the changed
            # endpoint from the replicated registration, including on secondaries.
            until(lambda: members[moved] in command(until(leader), 'registry'))
            # Two down: the former leader may read until its lease expires, then must refuse.
            survivor = until(leader)
            for id in list(children):
                if id != survivor: stop(id)
            time.sleep(.2)  # Outlast the 150 ms lease, including delayed acknowledgments.
            failed = command(survivor, 'sn-master-key', '--sn', '0', '--creation-second', creation, success=False)
            assert 'quorum' in failed.lower(), failed
            stop(survivor)
            for id in members: start(id)
            primary = until(leader)
            assert all(status(id).get('unlocked') == 'false' for id in children)
            until(lambda: all(int(status(id)['registered']) >= 2 for id in children))
            command(primary, 'unlock', '--key-file', ceremony/'unlock-key')
            until(lambda: all(status(id).get('unlocked') == 'true' for id in children))
            assert command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            if args.registrations_only:
                # Add a fourth member so one stops applying key state, but must
                # retain the public routing projection. The new process registers
                # before it has a voting slot; registration does not grant a slot.
                members['KS0-member3'] = f'127.0.0.1:{port()}'
                start('KS0-member3')
                until(lambda: members['KS0-member3'] in command(primary, 'registry'))
                assert status('KS0-member3')['raft_member_slot'] == 'none'
                membership_file = work/'members.json'
                membership_file.write_text(json.dumps(list(members)))
                until(lambda: command(primary, 'raft-members', '--members-file', membership_file) or True)
                until(lambda: sum(status(id).get('raft_applying') == 'true' for id in children) == 3)
                until(lambda: all(int(status(id)['registered']) == 3 for id in children))
                cold = next(id for id in children if status(id).get('raft_applying') == 'false')
                assert int(status(cold)['master_keys']) == 0
                print('PASS: replicated registrations; changed-port discovery with obsolete seeds; locked restart; primary failover; routing retained by cold member; registration does not grant a voting slot.')
                return
            # Corrupting the identity-selected latest journal requests replacement.
            replacing = next(id for id in members if id != primary)
            old_identity = status(replacing)['raft_member_id']
            old_slot = int(status(replacing)['raft_member_slot'])
            old_incarnation = int(status(replacing)['raft_member_incarnation'])
            stop(replacing)
            jdir = work/replacing/'data/master-keys'
            last_journal = max(jdir.glob('journal-*.log'), key=lambda path: int(path.stem.split('-')[-1]))
            last_journal.write_bytes(b'not a journal')

            start(replacing)
            until(lambda: status(replacing).get('raft_lost_state') == 'false')
            assert list(jdir.glob('journal-*.log.corrupt-*'))
            assert status(replacing)['raft_member_id'] != old_identity
            assert int(status(replacing)['raft_member_slot']) == old_slot
            assert int(status(replacing)['raft_member_incarnation']) == old_incarnation + 1
            assert until(leader) == primary
            until(lambda: status(replacing).get('unlocked') == 'true')
            assert command(replacing, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            # A retirement majority recovers without an old quorum. Keep snapshots;
            # this exercises recovery, not the deferred divergent-history problem #127.
            retiring = list(members)[:2]
            prior_ids = {id: status(id)['raft_member_id'] for id in retiring}
            for id in list(children): stop(id)
            for id in retiring:
                jdir = work/id/'data/master-keys'
                last_journal = max(jdir.glob('journal-*.log'), key=lambda path: int(path.stem.split('-')[-1]))
                last_journal.unlink(missing_ok=True)
            for id in members: start(id)
            def recovered_ring():
                # Demoted primaries intentionally exit. Supply the supervisor
                # restart that production uses, without hiding abnormal exits.
                for id, child in list(children.items()):
                    result = child.poll()
                    if result is not None:
                        assert result == 0, (id, result)
                        children.pop(id)
                        start(id)
                current = leader()
                if current and all(status(id).get('raft_lost_state') == 'false' for id in children):
                    return current
            primary = until(recovered_ring)
            assert all(status(id)['raft_member_id'] != prior_ids[id] for id in retiring)
            command(primary, 'unlock', '--key-file', ceremony/'unlock-key')
            until(lambda: all(status(id).get('unlocked') == 'true' for id in children))
            assert command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            # A fresh cold nonvoter copies committed state from a nonprimary peer.
            members['KS0-member3'] = f'127.0.0.1:{port()}'
            start('KS0-member3')
            applicant_id = status('KS0-member3')['raft_member_id']
            assert len(applicant_id) == 128
            assert status('KS0-member3')['raft_member_slot'] == 'none'
            stop('KS0-member3')
            start('KS0-member3')
            assert status('KS0-member3')['raft_member_id'] == applicant_id
            assert status('KS0-member3')['raft_member_slot'] == 'none'
            membership_file = work/'members.json'
            membership_file.write_text(json.dumps(list(members)))
            until(lambda: command(primary, 'raft-members', '--members-file', membership_file) or True)
            until(lambda: status('KS0-member3').get('unlocked') == 'true' and int(status('KS0-member3')['raft_commit']) >= int(status(primary)['raft_commit']))
            assert status('KS0-member3')['raft_member_id'] == applicant_id
            assert status('KS0-member3')['raft_member_slot'] == '3'
            until(lambda: sum(status(id).get('raft_applying') == 'true' for id in children) == 3)
            cold = next(id for id in children if status(id).get('raft_applying') == 'false')
            assert int(status(cold)['master_keys']) == 0
            until(lambda: len(list((work/cold/'data/master-keys').glob('snapshot-*.bin'))) > 1)
            assert command('KS0-member3', 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            # Losing identity cannot claim the old slot, even when its data survives.
            stop('KS0-member3')
            (work/'KS0-member3/data/master-keys/identity').unlink()
            start('KS0-member3')
            assert status('KS0-member3')['raft_member_slot'] == 'none'
            assert status('KS0-member3')['raft_lost_state'] == 'false'
            assert status('KS0-member3')['raft_member_id'] != applicant_id
            until(lambda: command(primary, 'raft-members', '--members-file', membership_file) or True)
            until(lambda: status('KS0-member3').get('unlocked') == 'true')
            until(lambda: status('KS0-member3')['raft_member_slot'] != 'none')
            assert int(status('KS0-member3')['raft_member_slot']) > 3
            assert command('KS0-member3', 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            removed = next(id for id in members if id not in (primary, 'KS0-member3'))
            membership_file.write_text(json.dumps([id for id in members if id != removed]))
            until(lambda: command(primary, 'raft-members', '--members-file', membership_file) or True)
            term = status(primary)['raft_term']
            time.sleep(1.5)
            assert status(primary)['raft_term'] == term
            assert command(primary, 'sn-master-key', '--sn', '0', '--creation-second', creation) == expected
            # Removing the current primary also terminates it after final commitment.
            membership_file.write_text(json.dumps([id for id in members if id not in (removed, primary)]))
            command(primary, 'raft-members', '--members-file', membership_file, success=False)
            departed = children[primary]
            until(lambda: departed.poll() is not None)
            exit_code = departed.wait(timeout=10)
            assert exit_code == 0, exit_code
            children.pop(primary)
            successor = until(leader)
            actual = command(successor, 'sn-master-key', '--sn', '0', '--creation-second', creation)
            assert actual == expected
            print('PASS: corrupt-journal recovery; missing-identity slotless readmission; automatic same-slot replacement; retirement-majority recovery; persistent random IDs; slotless applicant restart; primary-assigned slots; member restart on a changed port; demoted-primary process exit; primary removal exit; locked quorum; unlock propagation; committed key rotation; follower forwarding; primary failover; restart catch-up; quorum-loss read refusal; full locked restart; snapshot catch-up of a new member; joint membership; removed-member election suppression.')
        except BaseException:
            for id in members:
                if id in children:
                    try: print('STATUS', id, command(id, 'status'))
                    except Exception as e: print(e)
                path = work/id/'stderr'
                if path.exists(): print(id, path.read_text()[-6000:])
            raise
        finally:
            for child in children.values():
                if child.poll() is None: child.kill()
                child.wait(timeout=10)

if __name__ == '__main__': main()
