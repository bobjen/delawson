#!/usr/bin/env python3
"""Create/reuse ring IDs before starting a cluster.
Usage: ring-identities CLUSTER OUTPUT IDENTITY_FILE [KS_CONFIG_OR_DIRECTORY]
Keep IDENTITY_FILE across restarts. Every member generates its voting ID locally.
"""
import json
import os
from pathlib import Path
import secrets
import sys
import tomllib


def main():
    source, output, manifest = map(Path, sys.argv[1:4])
    text = source.read_text()
    config = tomllib.loads(text)
    saved = tomllib.loads(manifest.read_text()) if manifest.exists() else {}
    rings = saved.get('ring_identities', {})
    for table, values in [('ring_identities', rings)]:
        for name, value in config.get(table, {}).items():
            if name in values and values[name] != value:
                raise SystemExit(f'{table} changed for {name}')
            values[name] = value
    numbers = {}
    path = Path(sys.argv[4]) if len(sys.argv) > 4 else None
    for service in config.get('service', []):
        kind = service['kind']
        for _ in range(service.get('count', 1)):
            number = numbers.get(kind, 0)
            numbers[kind] = number + 1
            if kind not in ('ks', 'sn', 'dn'):
                continue
            name = service.get('identity', f'{kind.upper()}{number}')
            raft = {}
            if kind in ('ks', 'sn') and path:
                cfg = path
                if path.is_dir():
                    cfg = path / f'{name}.toml'
                    if not cfg.exists():
                        cfg = path / f'{kind}.toml'
                raft = tomllib.loads(cfg.read_text()).get('raft', {})
            ring = raft.get('ring', name) if raft.get('members') else name
            rings.setdefault(ring, rings.get(name, secrets.token_hex(64)))
            if name in rings and rings[name] != rings[ring]:
                raise SystemExit(f'{name} belongs to a different ring')
            rings[name] = rings[ring]
    for table in (rings,):
        for name, value in table.items():
            if len(value) != 128 or any(c not in '0123456789abcdef' for c in value):
                raise SystemExit(f'invalid identity for {name}')
    def table_text(name, values):
        return f'\n[{name}]\n' + ''.join(
            f'{json.dumps(k)} = {json.dumps(v)}\n' for k, v in sorted(values.items()))
    manifest_text = table_text('ring_identities', rings)
    temporary = manifest.with_suffix('.tmp')
    with temporary.open('w') as file:
        file.write(manifest_text)
        file.flush()
        os.fsync(file.fileno())
    temporary.replace(manifest)
    fd = os.open(manifest.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
    for name, values in [('ring_identities', rings)]:
        if name in config:
            if values != config[name]:
                raise SystemExit(f'configured {name} is incomplete')
        else:
            text += table_text(name, values)
    output.write_text(text)


if __name__ == '__main__':
    main()
