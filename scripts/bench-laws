#!/usr/bin/env bash
# Start a cluster, ping it in parallel from several clients, report throughput
# and latency, stop the cluster.
#
# The ping asks for a few hundred instructions of work, so what this measures is
# the message path: per-message overhead at depth 1, and what per-connection
# coalescing recovers at depth above 1.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
profile=--release
clients=8
depth=64
warmup=2
seconds=10
to=KS0

usage() {
    cat <<'EOF'
usage: bench-laws [--debug] [--clients N] [--depth N] [--warmup SECONDS] [--seconds N] [--to IDENTITY]

  --debug     measure the debug build (the default is release, which is what to quote)
  --clients   parallel clients, one connection and thread each (default: 8)
  --depth     independent requests in flight per connection (default: 64)
  --warmup    unmeasured seconds first (default: 2)
  --seconds   measured seconds (default: 10)
  --to        which process to ping (default: KS0)
EOF
}

while (($#)); do
    case $1 in
        --debug) profile=--debug ;;
        --release|--retail) profile=--release ;;
        --clients) clients=$2; shift ;;
        --depth) depth=$2; shift ;;
        --warmup) warmup=$2; shift ;;
        --seconds) seconds=$2; shift ;;
        --to) to=$2; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "bench-laws: unknown argument $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

target=release
[[ $profile == --debug ]] && target=debug

"$root/scripts/start-laws" "$profile" > /dev/null
trap '"$root/scripts/stop-laws" > /dev/null' EXIT

laws=$root/target/$target/laws
cluster=$root/config/cluster.toml
"$laws" --config "$cluster" --to "$to" bench \
    --clients "$clients" --depth "$depth" --warmup "$warmup" --seconds "$seconds"
